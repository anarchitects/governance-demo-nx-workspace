{
  "name": "@nx-workspace/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@anarchitects/nx-governance": "^0.10.0",
    "@eslint/js": "^9.8.0",
    "@nx/esbuild": "22.7.3",
    "@nx/eslint": "22.7.3",
    "@nx/eslint-plugin": "22.7.3",
    "@nx/jest": "22.7.3",
    "@nx/js": "22.7.3",
    "@nx/node": "22.7.3",
    "@nx/workspace": "22.7.3",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/jest": "~30.0.0",
    "@types/node": "20.19.9",
    "esbuild": "^0.27.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.7.3",
    "prettier": "~3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "packageManager": "yarn@4.15.0",
  "nx": {
    "targets": {
      "repo-health": {
        "executor": "@anarchitects/nx-governance:repo-health",
        "options": {
          "profile": "governance.profile",
          "output": "cli"
        },
        "metadata": {
          "description": "Run governance health assessment for the workspace."
        }
      },
      "governance-graph": {
        "executor": "@anarchitects/nx-governance:governance-graph",
        "options": {
          "format": "html",
          "outputPath": "dist/governance/graph.html"
        },
        "metadata": {
          "description": "Generate a governance-enriched graph artifact and static HTML viewer from the Nx Project Graph."
        }
      }
    }
  }
}
