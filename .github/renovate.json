{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "enabledManagers": ["npm"],
  "includePaths": [
    "libs/booking-application/package.json",
    "libs/booking-domain/package.json",
    "libs/booking-infrastructure/package.json",
    "libs/booking-interface/package.json",
    "libs/customer-domain/package.json",
    "libs/shared-kernel/package.json",
    "package.json",
    ".yarnrc.yml",
    "yarn.lock"
  ],
  "timezone": "Europe/Brussels",
  "schedule": ["before 6am on the first day of the month"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "semanticCommitScope": null,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "automerge": false,
  "platformAutomerge": false,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "osvVulnerabilityAlerts": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"],
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Override preset grouping; keep production updates and majors separate unless explicitly grouped below.",
      "matchManagers": ["npm"],
      "groupName": null,
      "automerge": false
    },
    {
      "description": "Group ordinary development tools only for minor and patch updates.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": [
        "@eslint/js",
        "@swc-node/register",
        "@swc/core",
        "@swc/helpers",
        "@types/jest",
        "@types/node",
        "esbuild",
        "eslint",
        "eslint-config-prettier",
        "jest",
        "jest-environment-node",
        "jest-util",
        "jsonc-eslint-parser",
        "prettier",
        "ts-jest",
        "ts-node",
        "typescript",
        "typescript-eslint"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development-updates"
    },
    {
      "description": "Keep first-party Nx packages aligned; review and run required Nx migrations.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["nx", "@nx/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "nx-updates"
    },
    {
      "description": "Keep major upgrades separate and require manual review for every update.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "automerge": false
    }
  ],
  "prBodyNotes": [
    "Manual review required. Preserve existing runtime compatibility; package upgrades do not perform Nx migrations or authorize a Nest 12/Native migration.",
    "For published packages, review the affected Nx projects and correct Conventional Commit/release intent before merging. No automatic publishing or merging."
  ]
}
