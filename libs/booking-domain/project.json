{
  "name": "booking-domain",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/booking-domain/src",
  "projectType": "library",
  "tags": ["domain: booking", "layer: domain"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/booking-domain",
        "main": "libs/booking-domain/src/index.ts",
        "tsConfig": "libs/booking-domain/tsconfig.lib.json",
        "assets": ["libs/booking-domain/*.md"]
      }
    }
  }
}
